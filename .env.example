# Configuración de Servidor y Entorno
BASE_PUBLIC_URL=https://creditob2b-production.up.railway.app
FLASK_ENV=production
PYTHONUNBUFFERED=1

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=https://creditob2b.cl,https://www.creditob2b.cl,https://creditob2b-production.up.railway.app

# Rate limiting. En producción con más de 1 worker usar Redis: redis://...
RATELIMIT_STORAGE_URI=memory://

# Firma HMAC para enlaces de descarga de facturas
INVOICE_SIGNING_SECRET=tu-secreto-largo-y-aleatorio

# Caché de consultas SII
SII_CACHE_TTL_SECONDS=21600
SII_CACHE_MAX_ITEMS=500

# Mercado Pago Pasarela de Pagos
MERCADO_PAGO_PUBLIC_KEY=APP_USR-tu-public-key
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-tu-access-token
MERCADO_PAGO_WEBHOOK_SECRET=tu-webhook-secret

# Base de Datos (PostgreSQL en Railway / Supabase)
DATABASE_URL=postgresql://usuario:password@host:5432/railway

# Servicio de Correo Electrónico (Recomendado: API HTTPS para evitar bloqueos en Railway)
EMAIL_API_KEY=re_tu_api_key_de_resend
EMAIL_FROM=contacto@creditob2b.cl
EMAIL_FROM_NAME=CréditoB2B Chile
EMAIL_API_URL=https://api.resend.com/emails
ADMIN_NOTIFICATION_EMAIL=contacto@creditob2b.cl,miltoncresporeyes@gmail.com,contacto@maestrofiel.cl

# Servicio de Correo Alternativo (SMTP clásico para entornos locales o VPS con puertos abiertos)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contacto@creditob2b.cl
SMTP_PASSWORD=tu-contraseña-smtp
SMTP_FROM_NAME=CréditoB2B Chile

